# Staging RTDB coordinates are public metadata, not connection authorization.
# Owner reports deployed rules deny-all; this checkout has not probed the endpoint.
# Configure externally; this file is not auto-loaded. Generic bindings are ignored
# when LUNA_FIREBASE_ENVIRONMENT=staging. Production template is unchanged.
LUNA_FIREBASE_ENVIRONMENT=staging
STAGING_FIREBASE_PROJECT_ID=lunazl-agent-staging-6dd7a
STAGING_FIREBASE_DATABASE_URL=https://lunazl-agent-staging-6dd7a-default-rtdb.asia-southeast1.firebasedatabase.app
# Region: asia-southeast1. No credential is needed for local rehearsal.
STAGING_FIREBASE_SERVICE_ACCOUNT_JSON=
STAGING_FIREBASE_LIVE_ENABLED=false
# local: dry-run on this machine.
# staging: still dry-run until the owner confirms a loopback or an approved network plan.
# production: refused by the preflight gate.

LUNA_DEPLOY_TARGET=staging
LUNA_DEPLOY_PRODUCTION_OPT_IN=false
LUNA_STAGING_URL=
LUNA_PRODUCTION_URL=
LUNA_STAGING_CONFIRMED=
LUNA_ENVIRONMENT_OWNER_CONFIRMED=
LUNA_CREDENTIAL_OWNER_CONFIRMED=
LUNA_BUDGET_CONFIRMED=
LUNA_SECURITY_APPROVAL=
LUNA_ROLLBACK_CONFIRMED=
LUNA_BROWSER_POLICY_CONFIRMED=
LUNA_ZALO_POLICY_CONFIRMED=
LUNA_ALLOW_LIVE_MODELS=false
LUNA_BROWSER_LAUNCH=false
NINE_ROUTER_BASE_URL=
NINE_ROUTER_API_KEY=
