# Luna Phase 2 foundations. Copy to a local env file outside git.
# Never commit a service account, REST token, cookie, or API key.

# Public coordinates for project lunazl-agent. The URL is not a secret.
# Setting it does not open a connection. Local tests keep the memory adapter.
FIREBASE_PROJECT_ID=lunazl-agent
FIREBASE_DATABASE_URL=https://lunazl-agent-default-rtdb.asia-southeast1.firebasedatabase.app

# JSON of a service account, supplied by the environment, never by source code.
# Leave empty. It is not a Realtime Database REST token and is not sent.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Explicit runtime opt-in. false keeps the memory adapter.
# true still does not connect unless a caller injects a transport and a REST credential.
FIREBASE_LIVE_ENABLED=false

# Legacy alias of FIREBASE_LIVE_ENABLED. Leave false.
LUNA_FIREBASE_LIVE=false

# In-process emulator flag. The server ignores it and does not open a socket.
LUNA_FIREBASE_EMULATOR=false

# 9Router OpenAI-compatible base. Default is loopback only.
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1

# Key for a local 9Router gateway. Never paste a provider key into git.
NINE_ROUTER_API_KEY=

# Asking for live models still stays on the mock provider. Cost stays zero.
LUNA_ALLOW_LIVE_MODELS=false

# Mock policy only. Retries are recorded and not sent to a network.
LUNA_MODEL_TIMEOUT_MS=15000
LUNA_MODEL_MAX_RETRIES=0
