# Luna Phase 0/1 — placeholders only.
# Copy to a local env file if you run outside this workspace. Never commit real values.
# Phase 0/1 ignores live flags and will not open Firebase or 9Router connections.

# Public Firebase coordinates. Do not put a token in the URL.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=https://YOUR_PROJECT.firebasedatabase.app

# JSON of a service account, supplied by the environment, never by source code.
# Leave empty until the repo owner chooses a project.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Asking for live Firebase still returns a phase-locked adapter in Phase 0/1.
LUNA_FIREBASE_LIVE=false

# 9Router OpenAI-compatible base. Default is loopback only.
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1

# Key for a local 9Router gateway. Never paste a provider key into git.
NINE_ROUTER_API_KEY=

# Asking for live models still stays on the mock provider in Phase 0/1.
LUNA_ALLOW_LIVE_MODELS=false
